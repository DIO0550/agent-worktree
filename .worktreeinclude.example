# .worktreeinclude のサンプル
# プロジェクトルートに .worktreeinclude として置く
#
# 記法は .gitignore と同じ。ただしコピーされるのは
# 「このパターンに一致し、かつ gitignore 済みの未追跡ファイル」のみ。
# (git 管理下のファイルは worktree に元から入るため対象外)

.env
.env.*
**/.claude/settings.local.json

# スキル / カスタムコマンドを gitignore している場合は、
# 使っているエージェントの置き場を足す
# .agents/skills/**              # Antigravity (agy) / Gemini CLI / opencode
# .gemini/skills/**              # Gemini CLI
# .gemini/commands/**            # Gemini CLI (.toml コマンド)
# .opencode/skills/**            # opencode
# .opencode/commands/**          # opencode
# .cursor/commands/**            # Cursor CLI (cursor-agent)
# .cursor/rules/**               # Cursor CLI (cursor-agent)
# .claude/skills/**              # Claude Code
# .claude/commands/**            # Claude Code
# .codex/prompts/**              # Codex

# 拡張機能ごと持ち込みたい場合の例
# .gemini/extensions/**
