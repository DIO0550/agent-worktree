#!/usr/bin/env bash
# agent-worktree コア CLI
#
# 任意の CLI エージェント (codex / agy など) を git worktree 内で起動するための
# worktree 解決・作成・選択・.worktreeinclude 展開を担う。
#
# サブコマンド:
#   wt resolve <name>      worktree のパスを出力 (無ければ作成)
#   wt create  <name>      worktree を新規作成してパスを出力
#   wt select              矢印キーのセレクタでパスを1つ出力 (新規作成も可)
#   wt list                worktree 一覧を表示
#   wt remove [-f] <name>  worktree とブランチを削除 (-f: 未コミットの変更ごと削除)
#   wt cleanup <name>      「残す / 削除」を矢印キーのセレクタで選んで後始末
#   wt include <path>      指定 worktree へ .worktreeinclude を手動展開
#
# 環境変数:
#   WT_ROOT_DIR       worktree の配置先 (既定: .claude/worktrees) ※メイン worktree からの相対
#   WT_BRANCH_PREFIX  ブランチ名の接頭辞 (既定: worktree-)
#   WT_BASE_REF       分岐元 (既定: origin/HEAD → 無ければ HEAD)
set -euo pipefail

WT_ROOT_DIR="${WT_ROOT_DIR:-.claude/worktrees}"
WT_BRANCH_PREFIX="${WT_BRANCH_PREFIX:-worktree-}"

err() { printf 'wt: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# git ヘルパー
# ---------------------------------------------------------------------------

main_worktree() {
  # `git worktree list` の先頭がメイン worktree
  git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}'
}

ensure_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git リポジトリ内で実行してください"
}

base_ref() {
  if [ -n "${WT_BASE_REF:-}" ]; then
    printf '%s\n' "$WT_BASE_REF"
    return
  fi
  # origin/HEAD が解決できればデフォルトブランチから分岐 (Claude Code と同じ挙動)
  local ref
  if ref=$(git -C "$1" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "${ref#refs/remotes/}"
  else
    printf 'HEAD\n'
  fi
}

# ---------------------------------------------------------------------------
# .worktreeinclude 展開
#
# コピー対象 = 「gitignore 済みの未追跡ファイル」∩「.worktreeinclude のパターン」
# (Claude Code Desktop の仕様に合わせた AND 条件)
# パターン解釈は一時リポジトリの .gitignore として git 本体に委譲する。
# ---------------------------------------------------------------------------

copy_one() {
  # clonefile (APFS) が使えれば実体共有コピー、ダメなら通常コピー
  local src=$1 dst=$2
  mkdir -p "$(dirname "$dst")"
  cp -c "$src" "$dst" 2>/dev/null || cp "$src" "$dst"
}

expand_include() {
  local main=$1 dest=$2
  local include_file="$main/.worktreeinclude"
  [ -f "$include_file" ] || return 0

  local tmp
  tmp=$(mktemp -d) || die "mktemp に失敗しました"
  git init -q "$tmp"
  cp "$include_file" "$tmp/.gitignore"

  local copied=0 rel
  while IFS= read -r rel; do
    [ -f "$main/$rel" ] || continue          # ディレクトリ項目はファイル単位で列挙済み
    [ -e "$dest/$rel" ] && continue          # 既存ファイルは上書きしない
    copy_one "$main/$rel" "$dest/$rel"
    copied=$((copied + 1))
  done < <(
    git -C "$main" ls-files --others --ignored --exclude-standard \
      | git -C "$tmp" check-ignore --stdin 2>/dev/null || true
  )
  rm -rf "$tmp"
  err ".worktreeinclude: ${copied} 個のファイルをコピーしました"
}

# ---------------------------------------------------------------------------
# worktree 操作
# ---------------------------------------------------------------------------

wt_path_of() {
  # 名前 → 既存 worktree のパス (無ければ空)
  local main=$1 name=$2
  local candidate="$main/$WT_ROOT_DIR/$name"
  git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' \
    | grep -Fx "$candidate" || true
}

wt_create() {
  local main=$1 name=$2
  local path="$main/$WT_ROOT_DIR/$name"
  local branch="${WT_BRANCH_PREFIX}${name}"
  local base
  base=$(base_ref "$main")

  [ -e "$path" ] && die "既にディレクトリが存在します: $path"
  mkdir -p "$main/$WT_ROOT_DIR"

  if git -C "$main" show-ref -q --verify "refs/heads/$branch"; then
    err "既存ブランチ $branch をチェックアウトします"
    git -C "$main" worktree add "$path" "$branch" >&2
  else
    err "$base から $branch を作成します"
    git -C "$main" worktree add -b "$branch" "$path" "$base" >&2
  fi
  expand_include "$main" "$path"
  printf '%s\n' "$path"
}

wt_list_names() {
  # WT_ROOT_DIR 配下にある worktree の名前一覧
  local main=$1 p
  git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' \
    | while IFS= read -r p; do
        case "$p" in
          "$main/$WT_ROOT_DIR"/*) printf '%s\n' "${p#"$main/$WT_ROOT_DIR/"}" ;;
        esac
      done
}

wt_dirty_count() {
  # 未コミット (変更 + 未追跡) のファイル数。git worktree remove が拒否する条件と同じ
  git -C "$1" status --porcelain 2>/dev/null | awk 'END{print NR}'
}

# worktree とブランチを削除する
# $1=メイン worktree, $2=名前, $3=worktree のパス, $4=force (1 なら未コミットの変更ごと削除)
#
# ブランチは未マージなら force でも残す。worktree の中身は使い捨てでも
# コミット済みの成果まで消えると復旧できないため。
wt_remove() {
  local main=$1 name=$2 path=$3 force=$4
  local branch="${WT_BRANCH_PREFIX}${name}"

  if [ "$force" -eq 1 ]; then
    git -C "$main" worktree remove --force "$path" >&2 || return 1
  else
    git -C "$main" worktree remove "$path" >&2 || return 1
  fi
  err "worktree を削除しました: $path"

  git -C "$main" show-ref -q --verify "refs/heads/$branch" || return 0
  if git -C "$main" branch -d "$branch" >/dev/null 2>&1; then
    err "ブランチ $branch を削除しました"
  else
    err "ブランチ $branch は未マージのため残しました (git branch -D $branch で削除できます)"
  fi
}

# ---------------------------------------------------------------------------
# セレクタ UI (fzf 不使用 / ANSI エスケープ / /dev/tty で対話)
#
# choose <見出し> <選択肢...>
#   矢印キー (または j/k) で選ばせ、選んだ添字を _WT_CHOICE に入れる。
#   中止 (q / ESC) なら 1 を返す。描画・入力は /dev/tty なので標準出力を汚さない。
# ---------------------------------------------------------------------------

_WT_CHOICE=0

has_tty() { { : </dev/tty >/dev/tty; } 2>/dev/null; }

choose() {
  local header=$1; shift
  local -a items=("$@")
  local count=${#items[@]} cur=0 i key rest

  [ "$count" -gt 0 ] || return 1
  has_tty || { err "対話端末が無いため選択できません"; return 1; }

  exec 3</dev/tty 4>/dev/tty
  printf '%s\n' "$header" >&4
  # 初回描画分の行を確保
  for ((i = 0; i < count; i++)); do printf '\n' >&4; done

  while :; do
    printf '\033[%dA' "$count" >&4
    for ((i = 0; i < count; i++)); do
      if [ "$i" -eq "$cur" ]; then
        printf '\033[2K\033[7m > %s \033[0m\n' "${items[i]}" >&4
      else
        printf '\033[2K   %s\n' "${items[i]}" >&4
      fi
    done

    IFS= read -rsn1 key <&3 || key=q
    if [ "$key" = $'\x1b' ]; then
      IFS= read -rsn2 -t 0.05 rest <&3 || rest=''
      case "$rest" in
        '[A') cur=$(( (cur + count - 1) % count )) ;;
        '[B') cur=$(( (cur + 1) % count )) ;;
        *) exec 3<&- 4>&-; return 1 ;;          # ESC 単押しで中止
      esac
    elif [ "$key" = 'q' ]; then
      exec 3<&- 4>&-; return 1
    elif [ -z "$key" ]; then                     # Enter
      break
    elif [ "$key" = 'k' ]; then cur=$(( (cur + count - 1) % count ))
    elif [ "$key" = 'j' ]; then cur=$(( (cur + 1) % count ))
    fi
  done

  exec 3<&- 4>&-
  _WT_CHOICE=$cur
}

selector() {
  local main=$1
  local -a items=()
  local name
  while IFS= read -r name; do items+=("$name"); done < <(wt_list_names "$main")
  items+=("+ 新規作成")

  choose 'worktree を選択 (↑↓: 移動, Enter: 決定, q: 中止)' "${items[@]}" || return 1

  local choice="${items[$_WT_CHOICE]}"
  if [ "$choice" = "+ 新規作成" ]; then
    printf 'worktree 名: ' >/dev/tty
    IFS= read -r name </dev/tty || return 1
    [ -n "$name" ] || return 1
    cmd_resolve "$name"
  else
    printf '%s\n' "$main/$WT_ROOT_DIR/$choice"
  fi
}

# ---------------------------------------------------------------------------
# サブコマンド
# ---------------------------------------------------------------------------

cmd_resolve() {
  local name=$1 main path
  main=$(main_worktree)
  path=$(wt_path_of "$main" "$name")
  if [ -n "$path" ]; then
    printf '%s\n' "$path"
  else
    wt_create "$main" "$name"
  fi
}

cmd_create() {
  local main; main=$(main_worktree)
  wt_create "$main" "$1"
}

cmd_select() {
  local main; main=$(main_worktree)
  selector "$main"
}

cmd_list() {
  git worktree list
}

cmd_remove() {
  local force=0 name='' arg main path
  for arg in "$@"; do
    case "$arg" in
      -f|--force) force=1 ;;
      -*) die "不明なオプション: $arg" ;;
      *)
        [ -z "$name" ] || die "使い方: wt remove [-f|--force] <name>"
        name=$arg
        ;;
    esac
  done
  [ -n "$name" ] || die "使い方: wt remove [-f|--force] <name>"

  main=$(main_worktree)
  path=$(wt_path_of "$main" "$name")
  [ -n "$path" ] || die "worktree が見つかりません: $name"

  if [ "$force" -eq 0 ] && [ "$(wt_dirty_count "$path")" -gt 0 ]; then
    die "未コミットの変更があるため削除しませんでした: $path (破棄してよければ wt remove -f $name)"
  fi
  wt_remove "$main" "$name" "$path" "$force" || die "worktree の削除に失敗しました: $path"
}

# エージェント終了後の後始末。「残す / 削除」をセレクタで選ばせる。
# 未コミットの変更があれば件数を見せたうえで、削除を選んだときだけ強制削除する。
cmd_cleanup() {
  local name=$1 main path dirty remove_label='削除'
  main=$(main_worktree)
  path=$(wt_path_of "$main" "$name")
  [ -n "$path" ] || return 0            # 既に無ければ何もしない

  # 対話できない環境 (制御端末なし) では残す
  has_tty || return 0

  dirty=$(wt_dirty_count "$path")
  if [ "$dirty" -gt 0 ]; then
    remove_label="削除 (未コミットの変更 ${dirty} 件を破棄)"
  fi

  choose "worktree \"$name\" をどうしますか？ (↑↓: 移動, Enter: 決定, q: 残す)" \
    '残す' "$remove_label" || return 0
  [ "$_WT_CHOICE" -eq 1 ] || return 0

  wt_remove "$main" "$name" "$path" 1 || die "worktree の削除に失敗しました: $path"
}

cmd_include() {
  local main; main=$(main_worktree)
  expand_include "$main" "$1"
}

usage() {
  # 先頭のコメントブロック (2行目〜最初の非コメント行の手前) をそのままヘルプにする
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

main() {
  ensure_repo
  local cmd=${1:-}
  shift || true
  case "$cmd" in
    resolve) [ $# -eq 1 ] || die "使い方: wt resolve <name>"; cmd_resolve "$1" ;;
    create)  [ $# -eq 1 ] || die "使い方: wt create <name>";  cmd_create "$1" ;;
    select)  cmd_select ;;
    list)    cmd_list ;;
    remove)  cmd_remove "$@" ;;
    cleanup) [ $# -eq 1 ] || die "使い方: wt cleanup <name>"; cmd_cleanup "$1" ;;
    include) [ $# -eq 1 ] || die "使い方: wt include <path>"; cmd_include "$1" ;;
    ""|-h|--help) usage ;;
    *) die "不明なサブコマンド: $cmd" ;;
  esac
}

main "$@"
